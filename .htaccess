Options -Indexes
# Hosted CGI PHP uses the always table for its explicit CORS allowlist.
# Clear inherited onsuccess headers without removing PHP's response headers.
# Local XAMPP mod_php uses onsuccess and inherits wildcard always headers.
<IfModule php_module>
    Header always unset Access-Control-Allow-Origin
    Header always unset Access-Control-Allow-Methods
    Header always unset Access-Control-Allow-Headers
</IfModule>
<IfModule !php_module>
    Header onsuccess unset Access-Control-Allow-Origin
    Header onsuccess unset Access-Control-Allow-Methods
    Header onsuccess unset Access-Control-Allow-Headers
</IfModule>
RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^$ /CoffeyTableRecipes/app/ [R=302,L]
RewriteRule ^api/v1(?:/.*)?$ index.php [QSA,L]
RewriteRule ^(?:config|src|database|bin|storage|vendor|tests)(?:/|$) - [F,L]
<FilesMatch "^(composer\.(json|lock)|README\.md|\.git.*)$">
    Require all denied
</FilesMatch>
