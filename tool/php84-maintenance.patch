+
+    @patch.dict(os.environ, CPANEL_USER='fixture', CPANEL_API_TOKEN='fixture-token')
+    def test_upgrade_verifies_replacement_before_removing_only_legacy_job(self):
+        legacy = {**self.job(), 'command':self.job()['command'].replace('/ea-php84/', '/ea-php82/')}
+        unrelated = {'command':'other-site-backup'}
+        with patch.object(schedule.migration, 'cron', side_effect=[
+                [legacy, unrelated], [], [legacy, unrelated, self.job()], [unrelated, self.job()]]) as cron, \
+                patch.object(schedule.migration, 'remove_job') as remove:
+            schedule.schedule()
+            remove.assert_called_once_with(unittest.mock.ANY, legacy['command'])
+            self.assertEqual([call.args[1] for call in cron.call_args_list], ['listcron','add_line','listcron','listcron'])
+
+    @patch.dict(os.environ, CPANEL_USER='fixture', CPANEL_API_TOKEN='fixture-token')
+    def test_failed_replacement_retains_legacy_daily_job(self):
+        legacy = {**self.job(), 'command':self.job()['command'].replace('/ea-php84/', '/ea-php82/')}
+        with patch.object(schedule.migration, 'cron', side_effect=[[legacy], RuntimeError('addition failed')]), \
